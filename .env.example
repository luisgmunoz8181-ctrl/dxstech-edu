# ==============================================================================
# DxSTech Edu — Variables de Entorno de Configuración
# ==============================================================================

# Entorno de la aplicación:
# - 'development': Modo local, acceso libre a WhatsApp y bot sin credenciales.
# - 'production': Modo producción, activa seguridad y restricciones.
APP_ENV=production

# Puerto interno en el que escuchará el servidor HTTP (por defecto: 3000)
PORT=3000

# Dirección de enlace (0.0.0.0 para escuchar en todas las interfaces dentro de Docker/Coolify)
HOST=0.0.0.0

# Directorio donde se almacena la base de datos SQLite (dxstech.db)
# En Docker/Coolify, debe ser la ruta mapeada al volumen persistente.
DATA_DIR=/app/data
