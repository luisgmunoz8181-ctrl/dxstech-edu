# ==============================================================================
# DxSTech Edu — Variables de Entorno de Configuración
# ==============================================================================

# Entorno de la aplicación:
# - 'development': Modo local, acceso libre a WhatsApp y bot sin credenciales.
# - 'production': Modo producción, activa seguridad y restricciones.
APP_ENV=production

# Puerto interno en el que escuchará el servidor HTTP (por defecto: 3000)
PORT=3000

# Dirección de enlace (0.0.0.0 para escuchar en todas las interfaces dentro de Docker/Coolify)
HOST=0.0.0.0

# Directorio donde se almacena la base de datos SQLite (dxstech.db)
# En Docker/Coolify, debe ser la ruta mapeada al volumen persistente.
DATA_DIR=/app/data

# ------------------------------------------------------------------------------
# Seguridad (OBLIGATORIO en producción)
# ------------------------------------------------------------------------------
# Secreto para firmar los JWT de sesión. Mínimo 32 caracteres. El servidor se
# niega a arrancar en producción sin este valor. Genere uno con:
#   openssl rand -hex 32
JWT_SECRET=

# URL pública de la aplicación (se usa para CORS y enlaces de verificación).
APP_URL=https://edu.tuempresa.com

# Orígenes adicionales autorizados para CORS con credenciales (separados por coma).
# Normalmente vacío: la SPA se sirve desde el mismo origen que la API.
CORS_ORIGINS=

# Proxies inversos de confianza (IP/CIDR separados por coma, o "none"). Por defecto
# los rangos privados (Docker/Coolify/Render). Solo de ellos se acepta X-Forwarded-For.
TRUSTED_PROXIES=

# Copias de seguridad automáticas (base de datos + archivos subidos)
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
# Por defecto $DATA_DIR/backups. Conviene apuntarlo a un volumen/disco distinto al de los datos.
BACKUP_DIR=

# Primer SUPERADMIN (solo se crea si la base de datos está vacía).
# Si no define la contraseña, se genera una aleatoria y se imprime UNA vez en el
# log de arranque. En ambos casos se obliga a cambiarla en el primer ingreso.
BOOTSTRAP_ADMIN_EMAIL=superadmin@dxstech.edu
BOOTSTRAP_ADMIN_PASSWORD=
